WP_ENV=development
WP_HOME=http://wordpress-composer-boilerplate.test
WP_SITEURL=${WP_HOME}/wp

DB_NAME=wordpress
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PREFIX=wp_

# Generate distinct values before any shared or production deployment.
AUTH_KEY=change-me
SECURE_AUTH_KEY=change-me
LOGGED_IN_KEY=change-me
NONCE_KEY=change-me
AUTH_SALT=change-me
SECURE_AUTH_SALT=change-me
LOGGED_IN_SALT=change-me
NONCE_SALT=change-me
