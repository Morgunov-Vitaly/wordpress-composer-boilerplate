# Local Docker environments generate this file with `mise run shared:up` or
# `mise run isolated:up`. Do not use a shared database for destructive work.
WP_ENV=development
APP_PORT=18000
WP_HOME=http://localhost:18000
WP_SITEURL=${WP_HOME}/wp

DB_MODE=isolated
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=db
DB_PREFIX=wp_

# Generate distinct values before any shared or production deployment.
AUTH_KEY=change-me
SECURE_AUTH_KEY=change-me
LOGGED_IN_KEY=change-me
NONCE_KEY=change-me
AUTH_SALT=change-me
SECURE_AUTH_SALT=change-me
LOGGED_IN_SALT=change-me
NONCE_SALT=change-me
